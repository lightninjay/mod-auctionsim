# Enable or disable the entire module
AuctionSim.Enabled = 0

# Bot character GUIDs, comma-separated (e.g. "12,45,201"). Each becomes an
# active bot character. Combined with BotAccountIDs below into one roster.
AuctionSim.BotCharacterIDs =

# Bot account ids, comma-separated. Every character on each listed account is
# automatically added to the bot roster -- convenient for a dedicated "bot farm"
# account with several toons instead of listing each character id by hand.
AuctionSim.BotAccountIDs =

# Deprecated single-character keys, kept only so an old auctionsim.conf still
# starts up. If set, migrate them into BotCharacterIDs / BotAccountIDs above and
# delete these two lines -- a future release may remove them.
AuctionSim.BotAccountID = 0
AuctionSim.BotCharacterID = 0

# Do a scan on server startup
AuctionSim.StartupScan = 0

# Maximum required level for items the bot will list. Items requiring a higher
# level to use are skipped before being created. 0 disables this filter.
# Useful for progression realms with a level cap below 80.
AuctionSim.MaxRequiredLevel = 0

# Maximum item level for items the bot will list. Items above this item level
# are skipped before being created. 0 disables this filter.
AuctionSim.MaxItemLevel = 0

# Explicit per-item, per-house auction house exceptions -- a manual override for
# items the MaxRequiredLevel/MaxItemLevel filters above don't catch (e.g. a
# low-level recipe or quest reward you still don't want auto-listed). Comma-
# separated "itemId:bitmask" pairs; a banned item is simply never listed on the
# matching house(s), and "Clean Over Cap" removes any of the bot's existing
# auctions for it there too.
#
# Bitmask bits (add them together to ban from more than one house):
#   1  Alliance auction house
#   2  Horde auction house
#   4  Neutral auction house (Booty Bay / Gadgetzan / Everlook)
#
# Example -- item 6661 (Savory Deviate Delight Recipe):
#   6661:1   banned from Alliance only
#   6661:2   banned from Horde only
#   6661:3   banned from Alliance AND Horde (1+2)
#   6661:4   banned from Neutral only
#   6661:5   banned from Neutral and Alliance (4+1)
#   6661:6   banned from Neutral and Horde (4+2)
#   6661:7   banned from ALL THREE (1+2+4)
#
# AuctionSim.ItemExceptions = 6661:7,12345:2
AuctionSim.ItemExceptions =

# For large curated exclusion lists (hundreds/thousands of ids) that would be
# unwieldy as a single inline config line above -- e.g. a full TBC item dump
# and a full WotLK item dump kept as two separate files. Comma-separated
# filenames, resolved relative to the SAME directory auctionsim.dat lives in
# (the module's config folder -- wherever auctionsim.dat was copied to at
# build time), so just drop the files there and list their names here.
#
# Each file is one entry per line: either a bare item id (which means
# "excluded from all three houses", the natural default for a flat dump list)
# or "itemId:mask" using the same 1/2/4 bitmask as above for per-house control
# within the file. Blank lines and lines starting with # are ignored.
#
# AuctionSim.ItemExceptionFiles = tbc_exclusions.txt,wotlk_exclusions.txt
AuctionSim.ItemExceptionFiles =

# Per-category listing multiplier vs. the real market.
#
# The bot decides how full to keep each (category, quality) from real Auctioneer
# scan data baked into auctionsim.dat: it tops a category up only once its live
# auction count drops below the observed lower quartile, and never past a random
# point between that quartile and the median. These values scale that target:
#
#   1     match the real market (the default)
#   1.5   keep the category 50% fuller than the real market
#   0.5   keep it half as full
#   0     never list anything in that category/quality
#
# Plain decimals -- enter 1, 1.5, 0.25, 0. The companion addon edits the same grid.
#
# The Warmane - Lordaeron realm has a hugely saturated auction house so the values
# were uniformly scaled down to a more reasonable level.
AuctionSim.ConsumablePercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ContainerPercent     = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.WeaponPercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GemPercent           = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ArmorPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ReagentPercent       = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ProjectilePercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.TradeGoodsPercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GenericPercent       = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.RecipePercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.MoneyPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.QuiverPercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.QuestPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.KeyPercent           = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.PermanentPercent     = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.MiscPercent          = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GlyphPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1

# Enable the Neutral (goblin) auction houses -- Booty Bay, Gadgetzan, Everlook.
# Neutral-eligible items (see NeutralItems below) list on BOTH their native
# Alliance/Horde house AND the Neutral house; they are never removed from their
# native house. Everything else continues to list only on its native house.
AuctionSim.EnableNeutralAH = 0

# Comma-separated item_template ids that should also list on the Neutral house
# -- typically faction-locked recipes/mounts/pets/reagents the opposing faction
# can otherwise only get through a neutral auction house. Curated by you: item
# faction/race flags aren't a reliable signal of "opposing-faction-only" in
# 3.3.5a data, so this isn't auto-detected. Edited more conveniently via the
# ahsim addon's drag-and-drop item pricer than by hand here.
AuctionSim.NeutralItems =

# How full the Neutral house is kept relative to its native house's observed
# depth, since auctionsim.dat never scans a Neutral house directly (see
# ASConfig::SynthesizeNeutralDepth). 1.0 would match the native house's target
# fullness; keep this below 1 so Neutral stays a supplemental channel.
AuctionSim.NeutralDepthScale = 0.5

# How often the module rescans the auction houses and re-lists/re-considers
# purchases, in minutes. Floored at 5 -- shorter risks the bot's own listing/
# buying decisions racing a scan pass that's still being processed, and
# needlessly hammers the auctionhouse tables. Default matches the old fixed
# 60-minute cadence.
AuctionSim.ScanIntervalMinutes = 60
